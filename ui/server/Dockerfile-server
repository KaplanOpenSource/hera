FROM hera:latest

WORKDIR /app/ui/server

COPY ui/server/requirements.txt .

RUN pip install --no-cache-dir -r requirements.txt

COPY ui/server/ .

EXPOSE 8000
EXPOSE 5678

WORKDIR /app

# No default project is baked in: MongoDB is not part of this image (it runs as a
# separate container, see ui/server/scripts/run_server_docker.sh), so the repository
# can only be registered once a reachable database exists. To add it at runtime:
#   hera-project repository add hera/doc/jupyter/Developer/Documentation_Repository.json

CMD ["python", "ui/server/server.py"]
# CMD ["bash", "-c", "sh hera/scripts/run_mongo.sh && python ui/server/server.py --debug"]
# CMD ["python", "-m", "debugpy", "--listen", "0.0.0.0:5678", "-m", "uvicorn", "server:app", "--app-dir", "ui/server", "--host", "0.0.0.0", "--port", "8000"]
