FROM hera-server

RUN curl -fsSL https://www.mongodb.org/static/pgp/server-7.0.asc | \
    gpg --dearmor -o /usr/share/keyrings/mongodb-server-7.0.gpg && \
    echo "deb [ signed-by=/usr/share/keyrings/mongodb-server-7.0.gpg ] https://repo.mongodb.org/apt/ubuntu jammy/mongodb-org/7.0 multiverse" \
      > /etc/apt/sources.list.d/mongodb-org-7.0.list && \
    apt-get update && \
    apt-get install -y mongodb-org && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /data/db

COPY mongo-init.d/50-create-users.js /docker-entrypoint-initdb.d/

COPY hera /app/hera
COPY ui/server /app/ui/server

WORKDIR /client
COPY ui/client/package.json ./package.json
RUN npm install
COPY ui/client/tsconfig.json ./
COPY ui/client/src ./src
COPY ui/client/tests ./tests
COPY ui/client/vitest.integ.config.ts ./

CMD ["bash", "-c", "\
    mongod --port 27018 --fork --logpath /var/log/mongodb.log --dbpath /data/db && \
    mongosh --port 27018 admin /docker-entrypoint-initdb.d/50-create-users.js --quiet && \
    npx vitest run tests/integration -c vitest.integ.config.ts --no-file-parallelism --retry 1 --exclude tests/integration/centralRepo.integ.test.tsx; \
    status=$?; \
    echo '\\n--- SERVER LOG ---'; \
    cat /tmp/hera-integ-*/server.log 2>/dev/null || echo 'no server log found'; \
    exit $status \
"]
