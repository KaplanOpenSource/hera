#! /usr/bin/env python
import requests
import os
import argparse
"""
creats a .bib file from all the alfresco files available to the user 
"""

# Configuration
ALFRESCO_URL = "http://mathsrv23:8020/alfresco"  # Set Alfresco URL

def get_all_documents(username,password):
    """
    Get all documents from Alfresco.
    """
    query = "TYPE:'cm:content'"  # Query to get all content types
    url = f"{ALFRESCO_URL}/api/-default-/public/search/versions/1/search"
    all_documents = []  # List to store all documents
    skip_count = 0  # Counter for skipping documents

    while True:
        resp = requests.post(
            url,
            auth=(username, password),
            json={
                "query": {"query": query},
                "paging": {"maxItems": 1000, "skipCount": skip_count},
                "include": ["properties"]
            }
        )

        resp.raise_for_status()  # Raises an error for bad responses
        data = resp.json()
        docs = data.get('list', {}).get('entries', [])

        all_documents.extend(docs)  # Add fetched documents to the list

        # Check if there are more documents to fetch
        if len(docs) < 1000:
            break  # No more documents to fetch

        skip_count += 1000  # Increment skipCount for the next request
    return all_documents

def get_metadata(properties, field_key, default_value):
    """Utility to get metadata, falling back on standard fields or a default value."""
    return properties.get(field_key) or properties.get(f'cm:{field_key.split(":")[-1]}') or default_value

def create_bibtex_entry(file_metadata):
    properties = file_metadata.get('properties', {})
    entry_id = None

    # Check for article fields
    if 'math:art_cite_key' in properties:
        entry_type = 'article'
        cite_key = get_metadata(properties, 'math:art_cite_key', 'error')
        title = get_metadata(properties, 'cm:title', 'No Title')
        author = get_metadata(properties, 'math:art_writers', 'Unknown')
        publish_date = get_metadata(properties, 'math:art_publishdate', properties.get('cm:created', 'Unknown Date'))
        year = publish_date.split('-')[0] if publish_date != 'Unknown Date' else properties.get('cm:created', 'Unknown Year').split('-')[0]

        journal = get_metadata(properties, 'math:art_journal', 'Unknown')
        volume = get_metadata(properties, 'math:art_volume', 'Unknown')
        number = get_metadata(properties, 'math:art_number', 'Unknown')
        pages = get_metadata(properties, 'math:art_pages', 'Unknown')
        note = get_metadata(properties, 'math:art_note', '')

        entry = f"@{entry_type}{{{cite_key},\n"
        entry += f"  author = \"{author}\",\n"
        entry += f"  title = \"{title}\",\n"
        entry += f"  year = \"{year}\",\n"
        entry += f"  journal = \"{journal}\",\n"
        entry += f"  volume = \"{volume}\",\n"
        entry += f"  number = \"{number}\",\n"
        entry += f"  pages = \"{pages}\",\n"
        entry += f"  note = \"{note}\",\n"
        entry += "}\n"
        return entry

    # Check for report fields
    elif 'math:rep_cite_key' in properties:
        entry_type = 'techreport'
        cite_key = get_metadata(properties, 'math:rep_cite_key','')
        author = get_metadata(properties, 'math:rep_writers', 'Unknown')
        institution = get_metadata(properties, 'math:rep_inst', 'Unknown')
        title = get_metadata(properties, 'cm:title', 'No Title')
        report_date = get_metadata(properties, 'math:rep_date', properties.get('cm:created', 'Unknown Date'))
        year = report_date.split('-')[0] if 'Unknown' not in report_date else 'Unknown Year'
        classification = get_metadata(properties, 'math:rep_classification', 'No classification')
        note = get_metadata(properties, 'math:rep_note', '')

        entry = f"@{entry_type}{{{cite_key},\n"
        entry += f"  author = \"{author}\",\n"
        entry += f"  institution = \"{institution}\",\n"
        entry += f"  title = \"{title}\",\n"
        entry += f"  year = \"{year}\",\n"
        entry += f"  classification = \"{classification}\",\n"
        entry += f"  note = \"{note}\",\n"
        entry += "}\n"
        return entry
    # Check for letter fields
    elif 'math:let_cite_key' in properties:
        entry_type = 'misc'
        cite_key = get_metadata(properties, 'math:let_cite_key','')
        title = get_metadata(properties, 'cm:title', 'No Title')
        author = get_metadata(properties, 'math:let_writer', 'Unknown')
        date = get_metadata(properties, 'math:let_date', properties.get('cm:created', 'Unknown Date'))
        year = date.split('-')[0] if 'Unknown' not in date else 'Unknown Year'
        classification = get_metadata(properties, 'math:let_classification', 'No classification')
        recipients = get_metadata(properties, 'math:let_recipients', 'Unknown')

        entry = f"@{entry_type}{{{cite_key},\n"
        entry += f"  author = \"{author}\",\n"
        entry += f"  title = \"{title}\",\n"
        entry += f"  year = \"{year}\",\n"
        entry += f"  classification = \"{classification}\",\n"
        entry += f"  recipients = \"{recipients}\",\n"

        entry += "}\n"
        return entry
    # Handle files without custom fields as misc
    else: return ''
    #
    #     entry_type = 'misc'
    #     title = get_metadata(properties, 'cm:name', '')
    #     writers = get_metadata(properties, 'cm:creator', 'Unknown')
    #     added_date = properties.get('cm:created', 'Unknown Date')
    #     entry_id = title.replace(" ", "_").lower()
    #
    #     # Extract year from added date (assuming format 'YYYY-MM-DD')
    #     year = added_date.split('-')[0] if 'Unknown' not in added_date else 'Unknown Year'
    #
    #     entry = f"@{entry_type}{{{entry_id},\n"
    #     entry += f"  author = \"{writers}\",\n"
    #     entry += f"  title = \"{title}\",\n"
    #     entry += f"  year = \"{year}\",\n"
    #     entry += "}\n"
    #     return entry
    #
def convert_to_bibtex(username,password):
    files = get_all_documents(username,password)
    bib_entries = []

    for file in files:
        bib_entry = create_bibtex_entry(file['entry'])
        bib_entries.append(bib_entry)

    # Write to .bib file
    filename = f"{username}_output.bib"
    with open(filename, 'w') as bibfile:
        bibfile.writelines(bib_entries)


if __name__ == "__main__":
    username = os.getenv("USER")
    parser = argparse.ArgumentParser(description="Read user information.")
    parser.add_argument('--password', type=str, help='The password of the current user', required=True)
    args = parser.parse_args()
    password = args.password

    convert_to_bibtex(username,password)

