#! /usr/bin/env python
# PYTHON_ARGCOMPLETE_OK

import argparse, argcomplete

from hera.simulations.LSM import CLI
from hera.utils import logging
from hera.utils.logging.helpers import initialize_logging, with_logger


if __name__ == "__main__":
    # Console logging setup
    initialize_logging(
        with_logger("hera.bin", handlers=['console'], level='DEBUG', propagate=False),
        with_logger("hera.utils", handlers=['console'], level='DEBUG', propagate=False)
    )

    logger = logging.getLogger("hera.bin.hera_projects")

    parser = argparse.ArgumentParser()
    lsm_subparsers = parser.add_subparsers(help='LSM runs')

    # setup
    setup_template = lsm_subparsers.add_parser('setup', help='setup template after loading its repository, creates symbolic links as necessary')
    setup_template.add_argument('templateName', type=str, default=None,
                            help='name of the template to setup')
    setup_template.add_argument('codeDir', type=str, default=None,
                            help="the directory with the template's code")
    setup_template.add_argument('--templateVersion', type=str, default="1",
                            help='version of the template, defaults to 1')
    setup_template.add_argument('--projectName', type=str, default=None,
                            help='name of the project that holds the template')
    setup_template.set_defaults(func=CLI.setup_template)
    
    # list
    list_templates = lsm_subparsers.add_parser(name='list', help='list all templates under the project')
    list_templates.add_argument('--projectName', type=str, default=None,
                            help='name of the project to be inspected, if not specified taken from caseConfiguration.json')
    list_templates.set_defaults(func=CLI.list_templates)


    argcomplete.autocomplete(parser)
    parsed = parser.parse_args()()
    logger.debug(f"Got {parsed} in the command line")
    if 'func' not in parsed:
        parser.print_help()
    else:
        parsed.func(parsed)

