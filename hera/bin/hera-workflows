#! /usr/bin/env python
# PYTHON_ARGCOMPLETE_OK

import argparse, argcomplete
import logging
from hera.simulations import CLI
from hera.utils.logging import initialize_logging, with_logger

if __name__ == "__main__":
    initialize_logging(
          with_logger("hera.simulations", handlers=['console'], level='INFO', propagate=False)
    #     with_logger("hera.simulations.hermesWorkflowToolkit", handlers=['console'], level='INFO', propagate=False),
    #     with_logger("hera.bin", handlers=['console'], level='DEBUG', propagate=False),
    )

    logger = logging.getLogger("hera.bin.hera_workflows")
    logger.debug("Starting the hera_workflows command line")

    PROJECT_NAME_HELP_DESC = 'The project name. [Optional]. If does not exist take from caseConfiguration'
    
    parser = argparse.ArgumentParser()
    subparsers = parser.add_subparsers(help='Topic:')
    
    ## --- List
    list_parser = subparsers.add_parser('list', help='Lists items in the DB')
    list_subparser = list_parser.add_subparsers(help='Handles simulation group')

    ## --- groups
    workflow_group_parser = list_subparser.add_parser('groups', help='List the group in the project.')
    workflow_group_parser.add_argument('--projectName', type=str, default=None, help=PROJECT_NAME_HELP_DESC)
    workflow_group_parser.add_argument('--solver', type=str,dest="solver", default=None, help='Specify the solver of the workflow')
    workflow_group_parser.add_argument('--workflowName',dest="workflowName",action="store_true", default=False, help='If exists, show the simulation names')
    workflow_group_parser.set_defaults(func=CLI.WorkflowsGroup_list)

    ## --- Workflows
    listSimulations_parser = list_subparser.add_parser('workflows', help='Lists the workflows in the group of that project.')
    listSimulations_parser.add_argument('group', type=str, default=None, help='The simulation group to list')
    listSimulations_parser.add_argument('--projectName', dest="projectName", default=None, type=str, help=PROJECT_NAME_HELP_DESC)
    listSimulations_parser.add_argument('--nodes', dest="nodes",action="store_true", default=False, help='If exsists, list the nodes of each simulation')
    listSimulations_parser.add_argument('--parameters', dest="parameters", action="store_true", default=False,
                                        help='If exsists, list the nodes of each simulation with their parameters (replace --nodes)')
    #listSimulations_parser.add_argument('--JSON', dest="json", default=False, type=bool,
    #                                    help='If exsists, return the results as JSON and not as pandas table')
    listSimulations_parser.set_defaults(func=CLI.workflow_list)

    ## --- Adds a workfow to the project. Optional execution.
    workflow_add_parser = subparsers.add_parser('add', help='Adds a workflow to the group in the group.')
    workflow_add_parser.add_argument('workflow', type=str, help='The workflow file to load')
    workflow_add_parser.add_argument('--projectName', type=str, default=None, help=PROJECT_NAME_HELP_DESC)
    workflow_add_parser.add_argument('--workflowGroup',dest="workflowGroup", default=None, type=str, help='The simulation group. [Optional]. If None, try to infer from the file name  ')
    workflow_add_parser.add_argument('--overwrite', dest="overwrite", action="store_true", default=False,
                                help='overwrite the existing workflow with the same name')
    workflow_add_parser.add_argument('--assignName', dest="assignName", action="store_true", default=False,
                                help='If true, finds a new name to the simulation based on the maximal id in the simulation group.')
    workflow_add_parser.add_argument('--allowDuplicate', dest="force", action="store_true", default=False,
                                help='Add the current workflow to the DB even if it exists there under a different name')
    workflow_add_parser.add_argument('--execute', dest="execute", action="store_true", default=False,
                                help='If flag exists, store the execute flag. ')
    workflow_add_parser.set_defaults(func=CLI.workflow_add)

    ## --- Adds a workfow to the project and executes it.
    workflow_build_exec_parser = subparsers.add_parser('buildExecute', help='Adds the workflow and executes it.')
    workflow_build_exec_parser.add_argument('workflowName', type=str, help='The workflow file to load')
    workflow_build_exec_parser.add_argument('--projectName', type=str, default=None, help=PROJECT_NAME_HELP_DESC)
    workflow_build_exec_parser.add_argument('--scheduler', dest="scheduler", choices=["local", "central"], default="local",
                                            help="Luigi scheduler to use. 'local' (default) runs with --local-scheduler; 'central' connects to a running luigid.")
    workflow_build_exec_parser.add_argument('--scheduler-host', dest="scheduler_host", type=str, default=None,
                                            help="Host of the central Luigi scheduler (only used with --scheduler central). Defaults to Luigi's default (localhost).")
    workflow_build_exec_parser.add_argument('--scheduler-port', dest="scheduler_port", type=int, default=None,
                                            help="Port of the central Luigi scheduler (only used with --scheduler central). Defaults to Luigi's default (8082).")
    workflow_build_exec_parser.add_argument('--dispatch-id', dest="dispatch_id", type=str, default=None,
                                            help="Unique id for this execution, propagated to all nodes. If omitted a uuid4 is generated.")
    workflow_build_exec_parser.set_defaults(func=CLI.workflow_buildExecute)


    ### --- Compare multiple workflows
    compare_parser = subparsers.add_parser('compare', help='Compare two or more workflows')
    compare_parser.add_argument('workflows', nargs="+", type=str,
                                help='[groupName] - compare all the simulations in the group, [sim1,sim2,..] compare the different simulations.old. simX is either a simulation name in the DB or a file on the disk')
    compare_parser.add_argument('--projectName', dest="projectName", default=None, type=str, help=PROJECT_NAME_HELP_DESC)
    compare_parser.add_argument('--longTable', dest="longFormat", action="store_true", default=False,
                                        help='If exsists, list the parameters as a long table. If does not exist data is pivoted')
    compare_parser.add_argument('--transpose', dest="transpose", action="store_true", default=False,
                                        help='If exsists, list the simulations as rows and the variables as columns')

    compare_parser.add_argument('--format', dest="format", default="pandas", choices=["pandas","json","latex","csv"],
                                        help='The output format: pandas (print the pandas), json, latex')

    compare_parser.add_argument('--file', dest="file", default=None,
                                        help='write the output to a file')
    compare_parser.set_defaults(func=CLI.workflow_compare)

    ### --- Delete and export a simulation
    delete_parser = subparsers.add_parser('delete', help='Delete a workflow. Exports the simulation that was deleted ')
    delete_parser.add_argument('workflows', nargs="+", type=str, help='the list of workflows to remove')
    delete_parser.add_argument('--projectName', type=str, default=None, help=PROJECT_NAME_HELP_DESC)
    delete_parser.add_argument('--export',dest="Export", default=False, action="store_true", help='Export the deleted file from the DB to the disk')
    delete_parser.add_argument('--overwrite', dest="forceOverwrite", default=False, action="store_true",
                               help='Overwrite the export if the file exists')

    delete_parser.set_defaults(func=CLI.workflow_delete)

    ### --- Export a simulation
    export_parser = subparsers.add_parser('export', help='Export the workflows to the disk')
    export_parser.add_argument('workflows', nargs="+", type=str,help='the list of workflows to export')
    export_parser.add_argument('--projectName', type=str, default=None, help=PROJECT_NAME_HELP_DESC)
    export_parser.add_argument('--overwrite', dest="forceOverwrite", default=False, action="store_true",
                               help='Overwrite the export if the file exists')

    export_parser.set_defaults(func=CLI.workflow_export)

    ### --- Compares DB workflows to their version on disk
    compare_to_disk_parser = subparsers.add_parser('compareToDisk', help='Compares the workflow in the DB to the file on the disk')
    compare_to_disk_parser.add_argument('workflows', nargs="+", type=str, help='the list of workflows to compare')
    compare_to_disk_parser.add_argument('--projectName', type=str, default=None, help=PROJECT_NAME_HELP_DESC)

    compare_to_disk_parser.set_defaults(func=CLI.workflow_compareToDisk)
    
    ### --- Sync a workflow from disk to DB
    sync_parser = subparsers.add_parser('sync', help='Syncs the workflow with the DB to the file on the disk. By default will sync only when there are changes in node parameters.')
    sync_parser.add_argument('workflows', nargs="+", type=str, help='the list of workflows to sync')
    sync_parser.add_argument('--projectName', type=str, default=None, help=PROJECT_NAME_HELP_DESC)
    sync_parser.add_argument('--force', "--f", dest="force", action="store_true", default=False, help="Forcefully override the DB with the file on disk")
    sync_parser.add_argument('--quiet', "--q", dest="quiet", action="store_true", default=False, help="Quitely check differences without printing")

    
    sync_parser.set_defaults(func=CLI.workflow_sync_to_db)
    
    ### --- create copies of a workflow variating the fields based on a variation JSON provided
    variation_parser = subparsers.add_parser('variation', aliases=["var"], help='Takes a workflow and creates new ones using the variation json provided')
    variation_parser.add_argument('workflow', type=str, help='the base workflow to use')
    variation_parser.add_argument('variationJson', type=str, help='path to file with variation data')
    variation_parser.add_argument('--projectName', type=str, default=None, help=PROJECT_NAME_HELP_DESC)
    variation_parser.add_argument('--dry-run', action="store_true", default=False, help="don't add the workflows to the project")
    variation_parser.add_argument('--overwrite', action="store_true", default=False, help="overwrite existing variations files")
    variation_parser.add_argument('--naming-scheme', type=str, choices=["index"], default="index", help="naming scheme used for the variation workflows. defaults to indexing(<base_name>_[0,1...])")

    
    variation_parser.set_defaults(func=CLI.create_workflow_variations)

    
    ### --- batch delete based on group name
    batch_delete_parser = subparsers.add_parser('batch-delete', aliases=["bigdelete"], help='Deletes all the workflows under the same group name')
    batch_delete_parser.add_argument('--projectName', type=str, default=None, help=PROJECT_NAME_HELP_DESC)
    batch_delete_parser.add_argument('--workflow', type=str, help='workflow to exclude, if group name not provided uses group name of this workflow')
    batch_delete_parser.add_argument('--groupName', type=str, help="the name of the group to delete")
    batch_delete_parser.add_argument('--hard', action="store_true", default=False, help="delete the resource of each workflow from disk")
    
    
    batch_delete_parser.set_defaults(func=CLI.batch_delete_workflows)
    ### ------------------------

    argcomplete.autocomplete(parser)
    parsed = parser.parse_args()

    logger.debug(f"Got {parsed} in the command line")
    if 'func' not in parsed:
        parser.print_help()
    else:
        parsed.func(parsed)
