FoamFile
{
    format      ascii;
    class       volVectorField;
    location    "0";
    object      U;
}

dimensions      [0 1 -1 0 0 0 0];

internalField   nonuniform List<vector> 4((0.1 0 0) (0.2 0.01 0) (0.3 0 -0.01) (0.4 0.02 0));

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform (1 0 0);
    }
    outlet
    {
        type            inletOutlet;
        inletValue      uniform (0 0 0);
        value           nonuniform List<vector> 3((0.5 0 0) (0.6 0 0) (0.7 0.1 0));
    }
    walls
    {
        type            noSlip;
    }
    sym
    {
        type            symmetry;
    }
    frontAndBack
    {
        type            empty;
    }
}
