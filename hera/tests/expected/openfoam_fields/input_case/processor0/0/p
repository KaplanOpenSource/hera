    {
        type            zeroGradient;
    }
    outlet
    {
        type            fixedValue;
        value           nonuniform List<scalar> 0();
    }
    walls
    {
        type            zeroGradient;
    }
    sym
    {
        type            symmetry;
    }
    frontAndBack
    {
        type            empty;
    }
    procBoundary0to1
    {
        type            processor;
        value           nonuniform List<scalar> 2(-0.125 1e-05);
    }
}
