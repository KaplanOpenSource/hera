{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Server (Docker)",
      "type": "node-terminal",
      "request": "launch",
      "command": "sh ui/server/build.sh && docker run -it -p 8000:8000 -p 5678:5678 --rm --name hera-server-instance hera-server",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Server debug (Docker)",
      "type": "node-terminal",
      "request": "launch",
      "command": "sh ui/server/build.sh && docker run -it -p 8000:8000 -p 5678:5678 --rm --name hera-server-instance hera-server python ui/server/server.py --debug",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Client (Vite/React Dev)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}/ui/client"
    },
    {
      "name": "Attach Python",
      "type": "debugpy",
      "request": "attach",
      "connect": {
        "host": "localhost",
        "port": 5678
      },
      "pathMappings": [
        {
          "localRoot": "${workspaceFolder}",
          "remoteRoot": "/app"
        }
      ],
      "preLaunchTask": "wait 5s"
    },
    {
      "name": "Python Debugger: Python File",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}"
    }
  ],
  "compounds": [
    {
      "name": "Server+Client",
      "configurations": [
        "Server (Docker)",
        "Client (Vite/React Dev)"
      ],
      "stopAll": true
    },
        {
      "name": "Debug Server+Client",
      "configurations": [
        "Server debug (Docker)",
        "Client (Vite/React Dev)",
        "Attach Python"
      ],
      "stopAll": true
    }
  ]
}
